# Copia este archivo como .env.local y rellena los valores.
# .env.local nunca se sube a git.

# --- Google Drive ---
# Identificador de la unidad compartida o carpeta raiz
DRIVE_CARPETA_RAIZ=

# Solo en produccion (Vercel): el contenido completo del archivo
# credenciales-drive.json en una sola linea.
# En local no hace falta: se lee del archivo.
DRIVE_CREDENCIALES=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Direccion publica (opcional) ---
# Cuando este publicado, poner aqui la direccion definitiva para que
# los codigos QR la usen aunque se impriman desde el computador.
NEXT_PUBLIC_URL_PUBLICA=

# --- Hoja de generacion (Google Sheets) ---
# La hoja de la que se traen horometro, combustible y kilovatios.
# Si no se pone, se usa la de la Extractora La Paz, que va en el codigo.
# La hoja tiene que estar compartida como LECTOR con el correo de la
# cuenta de servicio (el mismo de credenciales-drive.json).
HOJA_GENERACION_ID=

# Clave con la que el cron de Vercel se identifica al pedir la
# sincronizacion. Ponla tambien en Vercel -> Settings -> Environment
# Variables; Vercel la manda sola en la cabecera Authorization.
# Sin ella, cualquiera con la direccion podria disparar la corrida.
#
# El cron corre una vez al dia (11:00 UTC = 6 de la manana en Colombia),
# que es lo que permite el plan Hobby. Con plan Pro se puede subir la
# frecuencia cambiando el "schedule" de vercel.json.
CRON_SECRET=
